<Window x:Class="NearbyBoostSenderGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NearbyBoost" Height="720" Width="960" MinHeight="560" MinWidth="820"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============== SIDEBAR ============== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <StackPanel Orientation="Horizontal" Margin="4,8,0,24">
                    <TextBlock Text="Nearby" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Boost" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

                <RadioButton x:Name="NavTransfer" Content="Transfer" GroupName="Nav" IsChecked="True"
                             Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked" Margin="0,0,0,4"/>
                <RadioButton x:Name="NavDevices" Content="Devices" GroupName="Nav"
                             Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked" Margin="0,0,0,4"/>
                <RadioButton x:Name="NavHistory" Content="History" GroupName="Nav"
                             Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked" Margin="0,0,0,4"/>
                <RadioButton x:Name="NavSettings" Content="Settings" GroupName="Nav"
                             Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- ============== PAGES ============== -->
        <Grid Grid.Column="1" Margin="24">

            <!-- ===================== TRANSFER PAGE ===================== -->
            <Grid x:Name="TransferPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="20" Padding="4"
                        Margin="0,0,0,16" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SendModeRadio" Content="Send" GroupName="Mode" IsChecked="True"
                                     Style="{StaticResource ModeToggleButton}" Checked="ModeRadio_Checked"/>
                        <RadioButton x:Name="ReceiveModeRadio" Content="Receive" GroupName="Mode"
                                     Style="{StaticResource ModeToggleButton}" Checked="ModeRadio_Checked"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <StackPanel x:Name="SendPanel">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Select files or folders" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Files..." Padding="12,6" Margin="0,0,8,0" Click="BrowseButton_Click"/>
                                    <Button Grid.Column="1" Content="Folder..." Padding="12,6" Click="FolderButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="QueueEmptyText" Text="No files selected yet" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                <ListBox x:Name="QueueList" MaxHeight="150" Margin="0,4,0,0" Visibility="Collapsed">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding BadgeColor}" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding BadgeLabel}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Content="&#x2715;" Padding="8,2" FontSize="11" Click="RemoveQueueItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Send to" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="IpBox" Grid.Column="0" Margin="0,0,8,0" Text="192.168.43.1"/>
                                    <TextBox x:Name="PortBox" Grid.Column="1" Margin="0,0,8,0" Text="52525"/>
                                    <Button Grid.Column="2" Content="Scan" Padding="14,6" Margin="0,0,8,0" Click="ScanButton_Click"/>
                                    <Button x:Name="SendButton" Grid.Column="3" Content="Send" Padding="20,6"
                                            Style="{StaticResource AccentButton}" Click="SendButton_Click"/>
                                </Grid>
                                <TextBlock Text="Paired devices" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4"/>
                                <ListBox x:Name="QuickPairedList" MaxHeight="120" SelectionChanged="QuickPairedList_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ReceivePanel" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="This device" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="LocalAddressText" FontSize="16" FontWeight="Bold"
                                               Text="Not started" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ReceivePortBox" Grid.Column="1" Margin="8,0" Text="52525"/>
                                    <Button Grid.Column="2" x:Name="CopyAddressButton" Content="Copy" Padding="12,6"
                                            Margin="0,0,8,0" Click="CopyAddressButton_Click"/>
                                    <Button Grid.Column="3" x:Name="ReceiveToggleButton" Content="Start Server" Padding="16,6"
                                            Style="{StaticResource AccentButton}" Click="ReceiveToggleButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Save to" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="SaveLocationText" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ChooseSaveLocationButton" Content="Choose..." Padding="12,6"
                                        VerticalAlignment="Bottom" Click="ChooseSaveLocationButton_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CurrentFileText" FontWeight="Bold" Text="No transfer in progress" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="StopTransferButton" Content="Stop" Padding="14,4" Visibility="Collapsed" Click="StopTransferButton_Click"/>
                </Grid>

                <ProgressBar x:Name="ProgressBarCtl" Grid.Row="3" Minimum="0" Maximum="100"/>

                <ListBox x:Name="FileProgressList" Grid.Row="4" MaxHeight="130" Margin="0,10,0,0" Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Speed" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="SpeedText" Text="0.0 MB/s" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Progress" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time left" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="EtaText" Text="--" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Status" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Idle" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===================== DEVICES PAGE ===================== -->
            <Grid x:Name="DevicesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="180" Margin="0,0,0,16">
                    <Ellipse x:Name="Ripple1" Width="180" Height="180" Fill="#226750A4" Visibility="Hidden"/>
                    <Ellipse x:Name="Ripple2" Width="180" Height="180" Fill="#226750A4" Visibility="Hidden"/>
                    <Ellipse x:Name="Ripple3" Width="180" Height="180" Fill="#226750A4" Visibility="Hidden"/>
                    <Border x:Name="ScanCenterAvatar" Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="ScanCenterEmoji" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Button Grid.Row="1" x:Name="DevicesScanButton" Content="Scan for devices" Padding="20,10"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,0,0,20" Click="DevicesScanButton_Click"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Nearby" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock x:Name="NearbyEmptyText" Text="Tap Scan to look for devices" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                <ListBox x:Name="NearbyList" BorderThickness="0" SelectionChanged="NearbyList_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Paired devices" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="PairedEmptyText" Text="Devices pair automatically the first time you complete a transfer with them"
                                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                <ListBox x:Name="PairedList" BorderThickness="0" SelectionChanged="PairedList_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================== HISTORY PAGE ===================== -->
            <Grid x:Name="HistoryPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Transfer history" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                <ListView x:Name="HistoryListView" Grid.Row="1" MouseDoubleClick="HistoryListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Dir" Width="60" DisplayMemberBinding="{Binding Direction}"/>
                            <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Peer" Width="130" DisplayMemberBinding="{Binding Peer}"/>
                            <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Header="Avg Speed" Width="90" DisplayMemberBinding="{Binding AvgSpeed}"/>
                            <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- ===================== SETTINGS PAGE ===================== -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Your identity" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" x:Name="SettingsAvatarBorder" Width="56" Height="56" CornerRadius="28" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonUp="ChooseAvatarButton_Click">
                                    <TextBlock x:Name="SettingsAvatarEmoji" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox x:Name="SettingsNameInput" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                            <Button x:Name="ChooseAvatarButton" Content="Choose avatar" Margin="0,12,0,0" Padding="12,6" Click="ChooseAvatarButton_Click"/>
                            <Button x:Name="SaveIdentityButton" Content="Save" Style="{StaticResource AccentButton}" Margin="0,8,0,0" Padding="12,6" Click="SaveIdentityButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Theme" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="16" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme" Style="{StaticResource ModeToggleButton}" Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme" Style="{StaticResource ModeToggleButton}" Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Name="ThemeSystemRadio" Content="System" GroupName="Theme" Style="{StaticResource ModeToggleButton}" Checked="ThemeRadio_Checked"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Dark/System apply next time you open NearbyBoost." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Parallel transfer" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Send multiple files over several connections at once. Turn off to send one at a time — useful for a single very large file or a shaky connection."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ParallelTransferCheck" VerticalAlignment="Center" Checked="ParallelTransferCheck_Changed" Unchecked="ParallelTransferCheck_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
